# Sign in with Alternate Clouds: copy to .env.local and fill in.

# Create a PUBLIC client under Organization > Developer in the Alternate Clouds web app.
# Redirect URI: http://localhost:5173/callback   Post-logout redirect URI: http://localhost:5173/
VITE_ALTERNATE_CLOUDS_CLIENT_ID=ac_...

# Optional. Default https://auth.alternatefutures.ai (use the staging issuer for a staging client).
# VITE_ALTERNATE_CLOUDS_ISSUER=https://auth.alternatefutures.ai
